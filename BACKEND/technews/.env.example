DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/technews
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# MUST match the secret/algorithm your existing auth system signs JWTs with (claims: sub=user id, role)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
VIEWER_HASH_SECRET=change-me-too
TIMEZONE=Asia/Kolkata
INGEST_HOURS=0,8,16
CORS_ORIGINS=http://localhost:3000
# Optional: raises GitHub limit from 60/h to 5000/h
GITHUB_TOKEN=
# Google News / TechCrunch / ScienceDaily: set true ONLY after you've read their current feed terms
ENABLE_TERMS_RESTRICTED_SOURCES=false
# Reddit: needs approved Data API access incl. commercial approval if applicable
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_COMMERCIAL_APPROVED=false
# X: paid API access required for search
X_ENABLED=false
X_BEARER_TOKEN=
# Optional AI layer (any OpenAI-compatible endpoint, e.g. local Ollama http://ollama:11434/v1)
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
SENTRY_DSN=
